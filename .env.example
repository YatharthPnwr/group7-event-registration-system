# Copy this file to .env for local development.
# Local Postgres from docker-compose.yml (port 5433 avoids clashing with a system Postgres).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/events?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/events?schema=public"

# Used to sign login session cookies. Use a long random string in production.
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"

# Mailpit from docker-compose.yml. In production these point at a real SMTP server.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Event Registration <no-reply@events.local>"
